# Scouter aggregator: copy to scouter.env, fill in, then
#   set -a; . ./scouter.env; set +a; ./scouter-aggregator
# (or paste these as secrets in Coolify / docker --env-file). Never commit the copy.

# Required. Any long random string; the phone sends it as a bearer token.
SCOUTER_TOKEN=                          # e.g. the output of: openssl rand -hex 24
# Required. Fine-grained GitHub PAT, read-only Actions, Contents, Pull requests
# and Metadata on the repos you want to watch.
SCOUTER_GITHUB_TOKEN=github_pat_...

# Optional.
#SCOUTER_ADMIN_PASSWORD=                 # enables /admin (at least 12 characters)
#SCOUTER_COOLIFY_URL=https://coolify.example.com
#SCOUTER_COOLIFY_TOKEN=                  # read-only Coolify API token
#SCOUTER_HOOK_TOKEN=                     # token only for Claude Code hooks
#SCOUTER_RELEASE_TOKEN=                  # lets tools/release.sh publish APKs over the air
#SCOUTER_IGNORE_REPOS=owner/repo,owner/other
#SCOUTER_ADDR=:8080
#SCOUTER_DATA_DIR=/data                  # state.json and settings.json live here
