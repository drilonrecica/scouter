<?xml version="1.0" encoding="utf-8"?>
<!-- Scouter mark (branding/mark.svg): an angled lens with a clipped corner and
     one status dot, white when idle. Our own drawing; drawn to fit the round
     launcher mask as is, so no scaling group is needed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <!-- lens -->
    <path android:fillColor="#061412" android:strokeColor="#45B5A0" android:strokeWidth="6" android:strokeLineJoin="miter"
        android:pathData="M30,36 L68,32 L80,44 L80,72 L30,73 Z" />
    <!-- dot: glow, then the light itself -->
    <path android:fillColor="#E8E8E8" android:fillAlpha="0.22"
        android:pathData="M49,51 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 z" />
    <path android:fillColor="#E8E8E8"
        android:pathData="M54.5,51 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 z" />
    <!-- readout lines -->
    <path android:strokeColor="#45B5A0" android:strokeWidth="3.2" android:strokeLineCap="square"
        android:pathData="M38,63 H50 M38,57 H45" />
</vector>
